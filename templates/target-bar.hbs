<header class="mb-target-bar">
  <div class="mb-target-row">
    <div class="mb-target-pills">
      <button type="button"
              class="mb-pill {{#if broadcastAll}}active{{/if}}"
              data-action="clearRecipients"
              title="Play sounds to all connected players">
        <i class="fa-solid fa-tower-broadcast"></i> All Players
      </button>

      {{#each players}}
        <button type="button"
                class="mb-pill {{#if this.selected}}active{{/if}}"
                style="--player-color: {{this.color}}"
                data-action="toggleRecipient"
                data-user-id="{{this.id}}"
                title="Whisper audio to {{this.name}}">
          <span class="mb-dot" style="background: {{this.color}}"></span>
          {{this.name}}
        </button>
      {{/each}}
    </div>

    <div class="mb-toolbar-actions">
      <button type="button" class="mb-pill {{#if includeGMInWhisper}}active{{/if}}"
              data-action="toggleGMMonitor"
              aria-pressed="{{#if includeGMInWhisper}}true{{else}}false{{/if}}"
              title="Also play selected-player audio on this GM client; All Players and local previews are unaffected">
        <i class="fa-solid fa-headphones"></i> GM Monitor: {{#if includeGMInWhisper}}On{{else}}Off{{/if}}
      </button>
      <button type="button" class="mb-btn" data-action="addSound" title="Add Single Local File">
        <i class="fa-solid fa-plus"></i> Add File
      </button>
      <button type="button" class="mb-btn" data-action="addWebUrl" title="Add Direct HTTPS Audio Stream URL">
        <i class="fa-solid fa-link"></i> Add Web URL
      </button>
      <button type="button" class="mb-btn" data-action="setWatchFolder" title="Set Root Auto-Watch Folder (Subfolders = Categories, Sub-subfolders = Random Pools)">
        <i class="fa-solid fa-folder-tree"></i> Watch Folder
      </button>
      {{#if watchFolder}}
        <button type="button" class="mb-btn" data-action="rescanWatchFolder" title="Rescan Watch Folder ({{watchFolder}})" aria-label="Rescan Watch Folder">
          <i class="fa-solid fa-rotate"></i>
        </button>
      {{/if}}
      <button type="button" class="mb-btn mb-danger" data-action="stopAll" title="Stop All Active Cues">
        <i class="fa-solid fa-stop"></i> Stop All
      </button>
    </div>
  </div>

  <div class="mb-filter-row">
    <div class="mb-category-tabs">
      {{#each categories}}
        <button type="button"
                class="mb-cat-tab {{#if this.active}}active{{/if}}"
                data-action="selectCategory"
                data-category="{{this.name}}">
          {{this.name}}
        </button>
      {{/each}}
    </div>
    <input type="search"
           class="mb-search-input"
           placeholder="Search pads..."
           value="{{searchQuery}}" />
  </div>
</header>
