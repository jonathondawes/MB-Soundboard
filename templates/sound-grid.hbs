<section class="mb-sound-grid-container">
  {{#if sounds.length}}
    <div class="mb-sound-grid">
      {{#each sounds}}
        <button type="button"
                class="mb-sound-pad"
                data-action="triggerSound"
                data-sound-id="{{this.id}}"
                title="Left-Click: Play | Right-Click: Preview Locally | Shift+Right-Click: Delete">
          <i class="fa-solid fa-volume-high mb-pad-icon"></i>
          <span class="mb-pad-label">{{this.name}}</span>
          <span class="mb-pad-cat">{{this.category}}</span>
        </button>
      {{/each}}
    </div>
  {{else}}
    <div class="mb-empty-state">
      <p>No sound pads match the current view.</p>
      <p class="mb-hint">Click <strong>Add Pad</strong> or <strong>Import Folder</strong> above to populate your soundboard.</p>
    </div>
  {{/if}}
</section>
